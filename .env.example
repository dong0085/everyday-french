# Copy to .env.local for local development (values for local Supabase come from `supabase status`).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# 32 random bytes, base64: openssl rand -base64 32
KEY_ENCRYPTION_VERSION=1
KEY_ENCRYPTION_SECRET_V1=
# openssl rand -hex 24
CRON_SECRET=
# Local and test only. Never set on production.
ALLOW_MOCK_PROVIDERS=1
# Optional: shown on the privacy page
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DATA_REGION=
