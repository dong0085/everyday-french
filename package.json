{
  "name": "everyday-french",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "test:db": "docker exec -i supabase_db_everyday-french psql -U postgres -d postgres -q < tests/db/permissions.sql 2>&1 | (! grep FAIL)"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/deepseek": "3.0.64",
    "@ai-sdk/elevenlabs": "3.0.60",
    "@ai-sdk/google": "4.0.95",
    "@ai-sdk/groq": "4.0.60",
    "@ai-sdk/mistral": "4.0.63",
    "@ai-sdk/openai": "4.0.93",
    "@ai-sdk/openai-compatible": "3.0.68",
    "@ai-sdk/xai": "5.0.21",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "ai": "7.0.139",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "undici": "^8.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.15.0"
}
